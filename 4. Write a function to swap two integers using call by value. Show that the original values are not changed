#include <stdio.h>

void swapByValue(int a, int b) {
    int temp = a;
    a = b;
    b = temp;
    printf("Inside function (after swap): a = %d, b = %d\n", a, b);
}

int main() {
    int x, y;
    printf("Enter two integers: ");
    scanf("%d %d", &x, &y);
    printf("Before function call: x = %d, y = %d\n", x, y);
    swapByValue(x, y);
    printf("After function call (original values unchanged): x = %d, y = %d\n", x, y);
    return 0;
}
